<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Disloq variant codes (e.g. 2608060227122-14) find their product in every product search. -->
    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.disloq.codes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('disloq_variant_codes', 'ilike', self)]</attribute>
            </field>
        </field>
    </record>

    <record id="product_product_search_view" model="ir.ui.view">
        <field name="name">product.product.search.disloq.codes</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', ('default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self), ('disloq_variant_codes', 'ilike', self)]</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.disloq.codes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Disloq Codes" name="disloq_codes" invisible="not disloq_code_ids">
                    <field name="disloq_code_ids" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="label" string="Size / Colour"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
