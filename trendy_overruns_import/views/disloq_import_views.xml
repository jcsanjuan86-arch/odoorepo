<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="disloq_import_form" model="ir.ui.view">
        <field name="name">trendy.overruns.disloq.import.form</field>
        <field name="model">trendy.overruns.disloq.import</field>
        <field name="arch" type="xml">
            <form string="Import from Disloq">
                <div invisible="result" class="text-muted mb-3">
                    Upload a Disloq export as it is (the .zip or the .csv inside).
                    Products are matched by SKU and customers by name and phone, so importing a file again updates instead of duplicating.
                </div>
                <group invisible="result">
                    <field name="import_type" widget="radio"/>
                    <field name="warehouse_id" invisible="import_type == 'customers'" required="import_type == 'products'"
                           options="{'no_create': True}"/>
                    <field name="company_id" invisible="import_type == 'products'" options="{'no_create': True}"/>
                    <field name="data_file" filename="filename" required="not result"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div invisible="not result">
                    <h4>Import finished</h4>
                    <field name="result" nolabel="1" class="font-monospace"/>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary" invisible="result"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_disloq_import" model="ir.actions.act_window">
        <field name="name">Import from Disloq</field>
        <field name="res_model">trendy.overruns.disloq.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_disloq_import_pos" name="Import from Disloq" action="action_disloq_import"
              parent="point_of_sale.menu_point_config_product" sequence="90" groups="stock.group_stock_manager"/>
    <menuitem id="menu_disloq_import_stock" name="Import from Disloq" action="action_disloq_import"
              parent="stock.menu_stock_config_settings" sequence="90" groups="stock.group_stock_manager"/>
</odoo>
