<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salesforce_job_list" model="ir.ui.view">
        <field name="name">autoboutique.salesforce.job.list</field>
        <field name="model">autoboutique.salesforce.job</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'failed'" decoration-muted="state in ('done', 'cancelled')">
                <field name="create_date" string="Queued"/>
                <field name="job_type"/>
                <field name="vehicle_id"/>
                <field name="salesforce_record_id"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="next_attempt_at"/>
                <field name="last_error"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_salesforce_job_form" model="ir.ui.view">
        <field name="name">autoboutique.salesforce.job.form</field>
        <field name="model">autoboutique.salesforce.job</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary"
                            groups="autoboutique_salesforce.group_salesforce_manager"
                            invisible="state not in ('failed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="autoboutique_salesforce.group_salesforce_manager"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="job_type"/>
                            <field name="vehicle_id"/>
                            <field name="salesforce_record_id"/>
                            <field name="force"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="done_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="last_error" invisible="not last_error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_salesforce_job_search" model="ir.ui.view">
        <field name="name">autoboutique.salesforce.job.search</field>
        <field name="model">autoboutique.salesforce.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="salesforce_record_id"/>
                <filter name="open" string="Pending or Failed" domain="[('state', 'in', ('pending', 'failed'))]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="view_salesforce_log_list" model="ir.ui.view">
        <field name="name">autoboutique.salesforce.log.list</field>
        <field name="model">autoboutique.salesforce.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="status == 'error'" decoration-muted="status == 'skipped'">
                <field name="create_date" string="When"/>
                <field name="direction"/>
                <field name="operation"/>
                <field name="status"/>
                <field name="vehicle_id"/>
                <field name="sales_application_id" optional="show"/>
                <field name="salesforce_record_id" optional="hide"/>
                <field name="message"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_salesforce_log_search" model="ir.ui.view">
        <field name="name">autoboutique.salesforce.log.search</field>
        <field name="model">autoboutique.salesforce.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="salesforce_record_id"/>
                <filter name="errors" string="Errors" domain="[('status', '=', 'error')]"/>
                <filter name="outbound" string="Odoo → Salesforce" domain="[('direction', '=', 'outbound')]"/>
                <filter name="inbound" string="Salesforce → Odoo" domain="[('direction', '=', 'inbound')]"/>
            </search>
        </field>
    </record>

    <record id="action_salesforce_jobs" model="ir.actions.act_window">
        <field name="name">Salesforce Sync Queue</field>
        <field name="res_model">autoboutique.salesforce.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="action_salesforce_logs" model="ir.actions.act_window">
        <field name="name">Salesforce Sync History</field>
        <field name="res_model">autoboutique.salesforce.log</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_salesforce_settings" model="ir.actions.act_window">
        <field name="name">Salesforce Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'autoboutique_salesforce'}</field>
    </record>

    <menuitem id="menu_salesforce" name="Salesforce" parent="autoboutique_ops.menu_root" sequence="200"
              groups="autoboutique_salesforce.group_salesforce_user"/>
    <menuitem id="menu_salesforce_jobs" name="Sync Queue" parent="menu_salesforce"
              action="action_salesforce_jobs" sequence="10"/>
    <menuitem id="menu_salesforce_logs" name="Sync History" parent="menu_salesforce"
              action="action_salesforce_logs" sequence="20"/>
    <menuitem id="menu_salesforce_settings" name="Settings" parent="menu_salesforce"
              action="action_salesforce_settings" sequence="30" groups="base.group_system"/>
</odoo>
