<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        The homepage uses normal Odoo shop URLs. Products, prices, variants,
        inventory, cart, checkout, and payment remain managed by website_sale.
    -->
    <template id="homepage_content" name="Trendy Overruns Homepage Content">
        <div id="wrap" class="oe_structure trendy-overruns-homepage">
                <section class="to-hero">
                    <div class="container to-hero__inner">
                        <div class="to-hero__copy">
                            <img class="to-brand-logo" src="/trendy_overruns_website/static/src/img/trendy-overruns-logo.png" alt="Trendy Overruns Boutique"/>
                            <p class="to-eyebrow">TRENDY OVERRUNS BOUTIQUE</p>
                            <h1>Curated fashion,<br/>within reach.</h1>
                            <p class="to-lead">Fresh overrun finds, activewear, and everyday pieces selected for your style.</p>
                            <div class="to-hero__actions">
                                <a class="btn to-btn-primary" href="/shop">Shop new arrivals</a>
                                <a class="to-text-link" href="/shop">View all pieces <span aria-hidden="true">→</span></a>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="to-assurances" aria-label="Shop benefits">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-6 col-lg-3"><div class="to-assurance"><span>01</span><div><strong>Curated finds</strong><small>Pieces selected with care</small></div></div></div>
                            <div class="col-6 col-lg-3"><div class="to-assurance"><span>02</span><div><strong>Style made easy</strong><small>Everyday looks, one shop</small></div></div></div>
                            <div class="col-6 col-lg-3"><div class="to-assurance"><span>03</span><div><strong>Affordable picks</strong><small>Fashion within reach</small></div></div></div>
                            <div class="col-6 col-lg-3"><div class="to-assurance"><span>04</span><div><strong>Shop with ease</strong><small>Order securely online</small></div></div></div>
                        </div>
                    </div>
                </section>

                <section class="to-collection container">
                    <div class="to-section-heading">
                        <div>
                            <p class="to-eyebrow">THE EDIT</p>
                            <h2>Made for every day.</h2>
                        </div>
                        <a class="to-text-link" href="/shop">Shop the collection <span aria-hidden="true">→</span></a>
                    </div>
                    <div class="to-mosaic">
                        <a class="to-card to-card--colors" href="/shop" aria-label="Shop color collections">
                            <img src="/trendy_overruns_website/static/src/img/athletic-colors-collection.png" alt="Four activewear color options" loading="lazy"/>
                            <span>Color stories</span>
                        </a>
                        <a class="to-card to-card--active" href="/shop" aria-label="Shop activewear">
                            <img src="/trendy_overruns_website/static/src/img/activewear-collection.png" alt="Sage green activewear collection" loading="lazy"/>
                            <span>Activewear edit</span>
                        </a>
                        <a class="to-card to-card--flatlay" href="/shop" aria-label="Shop new arrivals">
                            <img src="/trendy_overruns_website/static/src/img/trendy-overruns-hero.png" alt="Curated neutral fashion pieces" loading="lazy"/>
                            <span>New arrivals</span>
                        </a>
                    </div>
                </section>

                <section class="to-shop-cta">
                    <div class="container text-center">
                        <p class="to-eyebrow">YOUR NEXT LOOK STARTS HERE</p>
                        <h2>Find something you will love.</h2>
                        <a class="btn to-btn-primary" href="/shop">Shop Trendy Overruns</a>
                    </div>
                </section>
        </div>
    </template>

    <!-- Disable the former global homepage override on module upgrade. -->
    <record id="homepage" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <record id="page_home" model="website.page">
        <field name="name">Trendy Overruns Home</field>
        <field name="url">/</field>
        <field name="type">qweb</field>
        <field name="is_published" eval="True"/>
        <field name="key">trendy_overruns_website.home</field>
        <field name="arch" type="xml">
            <t t-name="trendy_overruns_website.home">
                <t t-call="website.layout">
                    <t t-call="trendy_overruns_website.homepage_content"/>
                </t>
            </t>
        </field>
    </record>

    <record id="page_branches" model="website.page">
        <field name="name">Branches</field>
        <field name="url">/branches</field>
        <field name="type">qweb</field>
        <field name="is_published" eval="True"/>
        <field name="key">trendy_overruns_website.page_branches</field>
        <field name="arch" type="xml">
            <t t-name="trendy_overruns_website.page_branches">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure to-branches-page">
                        <section class="to-branches-hero">
                            <div class="container">
                                <p class="to-eyebrow">TRENDY OVERRUNS BOUTIQUE</p>
                                <h1>Visit a branch near you.</h1>
                                <p>Find us across Metro Manila for your next overrun find.</p>
                            </div>
                        </section>
                        <section class="container to-branches-list">
                            <div class="row g-4">
                                <div class="col-md-6 col-lg-4"><article class="to-branch-card"><h2>Fairview</h2><p>Lot 8, Blk 11, Dahlia Ave,<br/>West Fairview, Quezon City,<br/>Metro Manila</p></article></div>
                                <div class="col-md-6 col-lg-4"><article class="to-branch-card"><h2>Katipunan</h2><p>Ext, 226 Katipunan Ave,<br/>Project 4, Quezon City,<br/>1800 Metro Manila</p></article></div>
                                <div class="col-md-6 col-lg-4"><article class="to-branch-card"><h2>Lilac, Marikina City</h2><p>106 Lilac St, Concepcion Dos,<br/>Marikina City,<br/>1811 Metro Manila</p></article></div>
                                <div class="col-md-6 col-lg-4"><article class="to-branch-card"><h2>Tomas Morato</h2><p>Corner Tomas Morato Ave,<br/>Diliman, Quezon City,<br/>Metro Manila</p></article></div>
                                <div class="col-md-6 col-lg-4"><article class="to-branch-card"><h2>Valenzuela</h2><p>Unit 17-B, 2/F Valtown Center,<br/>Valenzuela</p></article></div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="menu_branches" model="website.menu">
        <field name="name">Branches</field>
        <field name="url">/branches</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="35"/>
    </record>

</odoo>
