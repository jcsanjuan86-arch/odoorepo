    <!-- LEAD FORM -->
    <record id="page_lead_form" model="website.page">
        <field name="name">Vehicle Inquiry Form</field>
        <field name="url">/lead-form</field>
        <field name="type">qweb</field>
        <field name="is_published" eval="True"/>
        <field name="key">autoboutique_website.lead_form</field>
        <field name="arch" type="xml">
<t t-name="autoboutique_website.lead_form"><t t-call="autoboutique_website.ab_layout">
<t t-set="title">Vehicle Inquiry Form | Prime Auto Boutique</t>
<t t-set="ab_vehicles" t-value="website._ab_vehicles()"/>
<section class="ab-lead" id="inquire">
    <form action="/autoboutique/inquiry" method="post" class="ab-lead-form">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="source" value="lead"/>
        <input type="hidden" name="redirect" value="/lead-form"/>
        <h1>Vehicle Inquiry Form</h1>
        <p class="ab-lead-intro">Please complete the form below and our team will assist you with your inquiry.</p>
        <div t-if="request.params.get('sent')" class="ab-form-ok">Thank you! Our team will contact you shortly.</div>
        <div t-if="request.params.get('error')" class="ab-form-err">Please enter your name and a mobile number or email.</div>
        <h2>Personal Information</h2>
        <label>Full Name <i>*</i><input type="text" name="name" required="required"/></label>
        <div class="ab-two">
            <label>Mobile Number <i>*</i><input type="tel" name="phone" required="required"/></label>
            <label>Email Address <i>*</i><input type="email" name="email" required="required"/></label>
        </div>
        <h2>Vehicle Interest</h2>
        <label>Which vehicle are you interested in? <i>*</i>
            <select name="vehicle_id" required="required">
                <option value="">Select a vehicle</option>
                <t t-foreach="ab_vehicles" t-as="car"><option t-att-value="car.id" t-out="car._ab_web_title()"/></t>
            </select>
        </label>
        <div class="ab-radio-row">
            <t t-foreach="[('sedan', 'Sedan'), ('suv', 'SUV'), ('pickup', 'Pickup'), ('mpv', 'MPV'), ('van', 'Van'), ('others', 'Others')]" t-as="opt">
                <label class="ab-radio"><input type="radio" name="body_type" t-att-value="opt[0]"/> <t t-out="opt[1]"/></label>
            </t>
        </div>
        <h2>Purchase Information</h2>
        <div class="ab-field-label">Preferred Payment Option <i>*</i></div>
        <div class="ab-radio-row">
            <label class="ab-radio"><input type="radio" name="payment_option" value="cash" required="required"/> Cash</label>
            <label class="ab-radio"><input type="radio" name="payment_option" value="financing"/> Financing</label>
        </div>
        <div class="ab-two">
            <label>Employment Status <small>(For Financing Applicants)</small>
                <select name="employment_status">
                    <option value="">Select</option>
                    <t t-foreach="[('employed', 'Employed'), ('self_employed', 'Self-Employed'), ('business_owner', 'Business Owner'), ('ofw', 'OFW'), ('freelancer', 'Freelancer'), ('others', 'Others')]" t-as="opt"><option t-att-value="opt[0]" t-out="opt[1]"/></t>
                </select>
            </label>
            <label>Estimated Monthly Income
                <select name="monthly_income">
                    <option value="">Select</option>
                    <t t-foreach="[('20_30', '₱20,000 – ₱30,000'), ('30_50', '₱30,001 – ₱50,000'), ('50_80', '₱50,001 – ₱80,000'), ('80_100', '₱80,001 – ₱100,000'), ('100_plus', 'Above ₱100,000')]" t-as="opt"><option t-att-value="opt[0]" t-out="opt[1]"/></t>
                </select>
            </label>
        </div>
        <h2>Appointment &amp; Follow-up</h2>
        <div class="ab-field-label">How can we assist you? <i>*</i></div>
        <div class="ab-radio-row">
            <t t-foreach="[('quotation', 'Request a Quotation'), ('visit', 'Schedule a Showroom Visit'), ('test_drive', 'Book a Test Drive'), ('financing', 'Financing Assistance')]" t-as="opt">
                <label class="ab-radio"><input type="radio" name="assistance" t-att-value="opt[0]" t-att-required="'required' if opt_first else None"/> <t t-out="opt[1]"/></label>
            </t>
        </div>
        <h2>Additional Message</h2>
        <label>Questions or Comments<textarea name="message" rows="4"/></label>
        <label class="ab-check"><input type="checkbox" name="consent" value="1" required="required"/> I agree to be contacted by Prime Auto Boutique regarding my inquiry and receive updates about available vehicles and promotions.</label>
        <button type="submit" class="ab-btn ab-btn-dark ab-btn-block">Submit Inquiry</button>
    </form>
</section>
</t></t>
        </field>
    </record>

