<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Pages are attached to the Autoboutique website by autoboutique_sync_websites (end of file). -->

    <!-- HOME -->
    <record id="page_home" model="website.page">
        <field name="name">Home</field>
        <field name="url">/home</field>
        <field name="type">qweb</field>
        <field name="is_published" eval="True"/>
        <field name="key">autoboutique_website.home</field>
        <field name="arch" type="xml">
<t t-name="autoboutique_website.home"><t t-call="autoboutique_website.ab_layout">
<t t-set="title">Prime Auto Boutique</t>
<t t-set="ab_vehicles" t-value="website._ab_vehicles()"/>
<section class="ab-hero" data-ab-slider="1">
    <t t-foreach="[
        ('650117872_1430073349134034_5202172560924559877_n-1.webp', 'Move Beyond Ordinary.', 'Discover world-class vehicles engineered for performance, safety, and innovation. Experience the future of mobility with elegant design and unmatched reliability.', '/vehicles'),
        ('627703295_1401473831993986_2111573698351034371_n-5-1.webp', 'Luxury Without Limits', 'Step into a new level of driving with vehicles that combine advanced technology, refined comfort, and powerful performance for every journey ahead.', '/about'),
        ('628029820_1401473301994039_9165145392062454833_n-1-1.webp', 'Elevate Every Drive', 'Experience premium vehicles crafted for luxury, performance, and sophistication. Discover exceptional automotive excellence designed to match your lifestyle and passion for driving.', '/services'),
    ]" t-as="slide">
        <div t-att-class="'ab-slide %s' % ('is-active' if slide_first else '')" t-attf-style="background-image: url('#{website._ab_static(slide[0])}')">
            <div class="ab-slide-content">
                <h1 t-out="slide[1]"/>
                <p t-out="slide[2]"/>
                <a t-att-href="slide[3]" class="ab-btn ab-btn-light">LEARN MORE</a>
            </div>
        </div>
    </t>
    <button type="button" class="ab-slide-prev" aria-label="Previous slide"><i class="fa fa-angle-left"/></button>
    <button type="button" class="ab-slide-next" aria-label="Next slide"><i class="fa fa-angle-right"/></button>
</section>

<section class="ab-glance">
    <div class="ab-glance-left">
        <h2>Prime Auto Boutique</h2>
        <div class="ab-glance-sub">at a glance</div>
        <h3>Your premium automotive journey starts here.</h3>
        <p>Log in to your Prime Auto Boutique account and experience luxury, performance, and convenience all in one place.</p>
        <a href="/web/login" class="ab-link-arrow">Log In or Sign Up Now</a>
    </div>
    <div class="ab-glance-right">
        <h3>Discover Everything Prime Auto Boutique Has to Offer</h3>
        <div class="ab-glance-items">
            <t t-foreach="[
                ('fa-car', 'Explore Vehicles', 'Browse our collection of sedans, high-performance SUVs, sports cars, executive vans, and exclusive imports.', '/vehicles'),
                ('fa-money', 'Apply for Financing', 'Drive your dream car sooner with flexible financing solutions tailored to your lifestyle and budget.', '/financing'),
                ('fa-wrench', 'Auto Services', 'Experience expert auto solutions, luxury vehicle support, and professional services designed for premium vehicle owners.', '/services'),
                ('fa-question-circle-o', 'FQAs', 'Find answers about vehicle inquiries, financing, reservations, maintenance services, and the Prime Auto Boutique experience.', '/faqs'),
            ]" t-as="item">
                <a t-att-href="item[3]" class="ab-glance-item">
                    <i t-att-class="'fa %s' % item[0]"/>
                    <h4 t-out="item[1]"/>
                    <p t-out="item[2]"/>
                    <span class="ab-red-link">EXPLORE <i class="fa fa-angle-right"/></span>
                </a>
            </t>
        </div>
    </div>
</section>

<section class="ab-excellence ab-container">
    <h2 class="ab-section-title">Experience Automotive Excellence</h2>
    <div class="ab-tabs" role="tablist">
        <button type="button" class="ab-tab is-active" data-tab="discover" role="tab">DISCOVER PRIME AUTO</button>
        <button type="button" class="ab-tab" data-tab="featured" role="tab">FEATURED VEHICLES</button>
    </div>
    <div class="ab-tab-panel is-active" data-panel="discover">
        <div class="ab-discover">
            <t t-foreach="[
                ('About Prime Auto', '/about', '627703295_1401473831993986_2111573698351034371_n-5-1.webp'),
                ('Services', '/services', '628029820_1401473301994039_9165145392062454833_n-1-1.webp'),
                ('Unit Release', '/unit-release', '650117872_1430073349134034_5202172560924559877_n-1.webp'),
            ]" t-as="card">
                <a t-att-href="card[1]" class="ab-discover-card" t-attf-style="background-image: url('#{website._ab_static(card[2])}')">
                    <h3 t-out="card[0]"/>
                    <span>EXPLORE <i class="fa fa-angle-right"/></span>
                </a>
            </t>
        </div>
    </div>
    <div class="ab-tab-panel" data-panel="featured">
        <div class="ab-brand-tabs">
            <button type="button" class="ab-brand-tab is-active" data-brand="">Featured units</button>
            <t t-foreach="website._ab_brands()" t-as="brand">
                <button type="button" class="ab-brand-tab" t-att-data-brand="brand" t-out="brand"/>
            </t>
        </div>
        <div class="ab-featured-row">
            <t t-foreach="ab_vehicles" t-as="car">
                <div class="ab-fcard" t-att-data-brand="car._ab_web_brand()" t-att-data-featured="'1' if car.website_featured else '0'">
                    <img t-att-src="website._ab_img(car, car._ab_card_field(), 800)" t-att-alt="car._ab_web_title()" loading="lazy"/>
                    <div class="ab-fcard-overlay"/>
                    <div class="ab-fcard-content">
                        <div class="ab-fcard-title" t-out="car._ab_web_title()"/>
                        <div class="ab-fcard-tagline" t-out="car.website_tagline"/>
                        <div class="ab-fcard-bottom">
                            <a t-att-href="car.website_url" class="ab-fcard-explore">Explore</a>
                            <div class="ab-fcard-price"><span>Starts At</span><b t-out="website._ab_money(car._ab_web_price())"/><small>MSRP</small></div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </div>
    <div class="ab-center"><a href="/vehicles" class="ab-btn ab-btn-outline">BROWSE ALL VEHICLES</a></div>
</section>

<section class="ab-offer-grid-wrap">
    <div class="ab-container ab-offer-grid">
        <t t-foreach="[
            ('image-2026-05-23T183117.169.webp', 'The Prime Experience', 'Learn more about Prime Auto Boutique your trusted destination for luxury vehicles, premium customer service, and exceptional automotive experiences.', 'LEARN MORE', '/about'),
            ('image-2026-05-23T183130.112.webp', 'Premium Auto Solutions', 'Experience premium automotive solutions including financing assistance, vehicle sourcing, maintenance support, and luxury auto care services.', 'LEARN MORE', '/services'),
            ('image-2026-05-23T183145.128.webp', 'Vehicle Handover Experience', 'Celebrate your new luxury vehicle experience with our professional and seamless unit release process designed for comfort and convenience.', 'LEARN MORE', '/unit-release'),
            ('image-2026-05-23T183153.704.webp', 'Luxury Vehicle Collection', 'Browse our curated collection of premium and luxury vehicles featuring top brands, modern performance, and elegant design.', 'LEARN MORE', '/vehicles'),
        ]" t-as="card">
            <a t-att-href="card[4]" class="ab-offer-card">
                <img t-att-src="website._ab_static(card[0])" alt="" class="ab-offer-icon"/>
                <h3 t-out="card[1]"/>
                <p t-out="card[2]"/>
                <span class="ab-red-link"><t t-out="card[3]"/> <i class="fa fa-angle-right"/></span>
            </a>
        </t>
        <t t-foreach="[
            ('000_12_1764663428867_000.webp', 'Smart Financing Options', 'Flexible and hassle-free financing options tailored to help you drive your dream vehicle with confidence and ease.', 'APPLY NOW', '/financing'),
            ('000_13_1764663520904_000.webp', 'Customer Support &amp; FAQs', 'Find answers to commonly asked questions about our vehicles, financing options, services, reservations, and dealership processes.', 'LEARN MORE', '/faqs'),
        ]" t-as="card">
            <a t-att-href="card[4]" class="ab-offer-wide">
                <img t-att-src="website._ab_static(card[0])" alt="" loading="lazy"/>
                <div>
                    <h3 t-out="card[1]"/>
                    <p t-out="card[2]"/>
                    <span class="ab-red-link"><t t-out="card[3]"/> <i class="fa fa-angle-right"/></span>
                </div>
            </a>
        </t>
    </div>
</section>

<section class="ab-explore-more">
    <h2 class="ab-giant">EXPLORE MORE PRIME AUTO</h2>
    <div class="ab-container">
        <div class="ab-split-dark">
            <div class="ab-split-img" t-attf-style="background-image: url('#{website._ab_static('650117872_1430073349134034_5202172560924559877_n-1.webp')}')"/>
            <div class="ab-split-box">
                <h3>The Prime Experience</h3>
                <p>Luxury vehicles, personalized service, and premium automotive care designed around your lifestyle. Experience excellence from a team committed to delivering sophistication and performance at every drive.</p>
                <a href="/about" class="ab-white-link">EXPLORE NOW <i class="fa fa-angle-right"/></a>
            </div>
        </div>
        <div class="ab-split-dark is-flipped">
            <div class="ab-split-box">
                <h3>Drive Beyond Limits</h3>
                <p>Freedom, performance, and innovation come together to create extraordinary driving experiences without compromise.</p>
                <a href="/vehicles" class="ab-white-link">EXPLORE NOW <i class="fa fa-angle-right"/></a>
            </div>
            <div class="ab-split-img" t-attf-style="background-image: url('#{website._ab_static('628029820_1401473301994039_9165145392062454833_n-1-1.webp')}')"/>
        </div>
    </div>
</section>
</t></t>
        </field>
    </record>

    <!-- ABOUT -->
    <record id="page_about" model="website.page">
        <field name="name">About Us</field>
        <field name="url">/about</field>
        <field name="type">qweb</field>
        <field name="is_published" eval="True"/>
        <field name="key">autoboutique_website.about</field>
        <field name="arch" type="xml">
<t t-name="autoboutique_website.about"><t t-call="autoboutique_website.ab_layout">
<t t-set="title">About Us | Prime Auto Boutique</t>
<t t-set="ab_vehicles" t-value="website._ab_vehicles()"/>
<section class="ab-who">
    <div class="ab-who-img" t-attf-style="background-image: url('#{website._ab_static('627703295_1401473831993986_2111573698351034371_n-5-1.webp')}')"/>
    <div class="ab-who-box">
        <h1>WHO WE ARE</h1>
        <p>Prime Auto Boutique is a premier luxury automotive destination dedicated to delivering exceptional vehicles, world-class service, and elevated driving experiences. Established with a passion for automotive excellence, Prime Auto Boutique offers a curated selection of luxury sedans, SUVs, sports cars, and premium mobility solutions tailored for modern lifestyles.</p>
    </div>
</section>
<section class="ab-container ab-about-text">
    <p>Our showroom and service facilities are designed to provide customers with a seamless and sophisticated automotive journey—from vehicle selection and financing to after-sales support and premium maintenance services.</p>
    <p>Driven by innovation, performance, and customer satisfaction, Prime Auto Boutique continues to redefine luxury mobility through personalized experiences, advanced automotive technology, and uncompromising quality standards.</p>
    <p>The company operates through key divisions focused on Sales, Customer Experience, Vehicle Services, Financing Solutions, Marketing, Logistics, and Premium Automotive Care to ensure every customer receives outstanding support throughout their ownership journey.</p>
    <div class="ab-stats">
        <div><i class="fa fa-car"/><b>35<sup>*</sup></b><span>Luxury Vehicle Models</span></div>
        <div><i class="fa fa-trophy"/><b>15<sup>*</sup></b><span>Luxury Vehicle Models</span></div>
        <div><img t-att-src="website._ab_static('006_22_1761033857710_000.webp')" alt=""/><b>25<sup>*</sup></b><span>Partner Showrooms Nationwide</span></div>
    </div>
</section>
<section class="ab-container ab-vm">
    <div>
        <h2>Our Vision</h2>
        <img t-att-src="website._ab_static('636151723_1409773021164067_5525308220956127380_n-1.webp')" alt="Prime Auto Boutique showroom" loading="lazy"/>
        <p>To become the leading luxury automotive company where passionate professionals work together to deliver premium vehicles, innovative mobility solutions, and exceptional customer experiences.</p>
    </div>
    <div>
        <h2>Our Mission</h2>
        <img t-att-src="website._ab_static('636151723_1409773021164067_5525308220956127380_n-1.webp')" alt="Prime Auto Boutique showroom" loading="lazy"/>
        <p>Driven by excellence and innovation, we commit ourselves:</p>
        <ul>
            <li>To provide premium vehicles and personalized automotive experiences tailored to every client’s lifestyle and aspirations.</li>
            <li>To deliver exceptional customer service through professionalism, transparency, and genuine care.</li>
            <li>To maintain the highest standards in vehicle quality, performance, and after-sales support.</li>
            <li>To continuously innovate through modern technology, sustainable mobility solutions, and premium automotive services.</li>
            <li>To foster a culture of teamwork, integrity, growth, and excellence among our people and partners.</li>
        </ul>
    </div>
</section>
<section class="ab-container ab-impact">
    <h2>OUR IMPACT &amp; CONTRIBUTIONS</h2>
    <div class="ab-impact-grid">
        <t t-foreach="[
            ('CUSTOMER EXPERIENCE', '006_22_1761033892290_000.webp', '2,500+', 'Satisfied Premium Vehicle Owners', '15,000+', 'Clients Served Nationwide'),
            ('INVESTMENTS &amp; GROWTH', '006_22_1761033895756_000.webp', '10 MILLION (PHP)', 'Luxury Automotive Investments', '20 MILLION (PHP)', 'Annual Business Growth Contribution'),
            ('PARTNERS &amp; NETWORK', '006_22_1761033899370_000.webp', '30+', 'Automotive and Luxury Brand Partners', '50+', 'Certified Service &amp; Support Specialists'),
            ('VEHICLE SALES', '006_22_1761033888761_000.webp', '12,500+ Units', 'Premium Vehicles Delivered', '2,300+ Units', 'Vehicles Sold in 2025'),
        ]" t-as="col">
            <div class="ab-impact-col">
                <h3 t-out="col[0]"/>
                <img t-att-src="website._ab_static(col[1])" alt=""/>
                <b><t t-out="col[2]"/><sup>**</sup></b><span t-out="col[3]"/>
                <b><t t-out="col[4]"/><sup>**</sup></b><span t-out="col[5]"/>
            </div>
        </t>
    </div>
</section>
</t></t>
        </field>
    </record>

    <!-- SERVICES -->
    <record id="page_services" model="website.page">
        <field name="name">Services</field>
        <field name="url">/services</field>
        <field name="type">qweb</field>
        <field name="is_published" eval="True"/>
        <field name="key">autoboutique_website.services</field>
        <field name="arch" type="xml">
<t t-name="autoboutique_website.services"><t t-call="autoboutique_website.ab_layout">
<t t-set="title">Services | Prime Auto Boutique</t>
<t t-set="ab_vehicles" t-value="website._ab_vehicles()"/>
<t t-set="banner_title">Prime Auto Services</t>
<t t-call="autoboutique_website.ab_page_banner"/>
<section class="ab-container ab-split">
    <img t-att-src="website._ab_static('628029820_1401473301994039_9165145392062454833_n-1-1.webp')" alt="Prime Auto Boutique service center" loading="lazy"/>
    <div>
        <p>Our Service Department is equipped to handle everything from routine maintenance to advanced vehicle repair works, including General and Preventive Maintenance, Accessories Installation, and Body &amp; Paint Services.</p>
        <p>We also offer Express Maintenance Services for quick and efficient vehicle care, including oil changes, tune-ups, and scheduled maintenance procedures — keeping your vehicle in top condition with minimal waiting time.</p>
    </div>
</section>
<section class="ab-gray">
    <div class="ab-container">
        <div class="ab-kicker">WHAT  WE OFFER</div>
        <h2 class="ab-section-title">Type of Service Packages</h2>
        <div class="ab-service-grid">
            <t t-foreach="[
                ('service-periodic.webp', 'PERIODIC MAINTENANCE', 'Keep your vehicle performing at its best with scheduled maintenance designed to ensure safety, reliability, and a smooth driving experience every time.'),
                ('service-general.webp', 'GENERAL SERVICE', 'From diagnostics to repairs, our skilled technicians provide professional vehicle servicing to keep your car running efficiently and reliably.'),
                ('service-body.webp', 'BODY &amp; PAINT', 'Restore your vehicle’s original appearance with high-quality body repair and paint refinishing services using premium materials and expert craftsmanship.'),
                ('service-dealer.webp', 'SERVICE CAMPAIGNS', 'Drive with confidence through our service campaigns, offering vehicle inspections, updates, and repair services whenever your vehicle qualifies.'),
                ('service-preventive.webp', 'OTHER SERVICES', 'Enhance your driving experience with premium detailing, interior sanitation, engine cleaning, ceramic coating, and other value-added services designed to keep your vehicle clean, protected, and road-ready.'),
            ]" t-as="svc">
                <div class="ab-service-card">
                    <img t-att-src="website._ab_static(svc[0])" t-att-alt="svc[1]" loading="lazy"/>
                    <h3 t-out="svc[1]"/>
                    <p t-out="svc[2]"/>
                </div>
            </t>
        </div>
    </div>
</section>
<section class="ab-container ab-split">
    <img t-att-src="website._ab_static('644434790_1420504663424236_984831337652890806_n.webp')" alt="Prime Auto Boutique showroom" loading="lazy"/>
    <div>
        <h2 class="ab-light-title">Why Service Your Car with Prime Auto Boutique?</h2>
        <p>Your vehicle deserves expert care from professionals who understand premium automotive performance and maintenance. At Prime Auto Boutique, we ensure your vehicle receives quality service, genuine attention, and long-term care.</p>
    </div>
</section>
<section class="ab-container ab-why">
    <div class="ab-kicker">WHAT  WE OFFER</div>
    <h2 class="ab-section-title">Why Choose Prime Auto Boutique</h2>
    <div class="ab-why-grid">
        <t t-foreach="[
            ('fa-map-o', 'Extensive network of trusted service and dealer partners nationwide'),
            ('fa-cogs', 'Advanced diagnostic tools and modern automotive equipment'),
            ('fa-clock-o', 'Fast and efficient Express Maintenance Service'),
            ('fa-calendar-check-o', 'Smart maintenance reminder and service tracking system'),
            ('fa-shield', 'Availability of premium genuine and high-quality replacement parts'),
            ('fa-certificate', 'Professionally trained and certified automotive technicians'),
            ('fa-file-text-o', 'Service procedures aligned with manufacturer warranty standards'),
            ('fa-coffee', 'Modern, clean, and comfortable customer lounge experience'),
        ]" t-as="why">
            <div class="ab-why-item"><i t-att-class="'fa %s' % why[0]"/><p t-out="why[1]"/></div>
        </t>
    </div>
</section>
</t></t>
        </field>
    </record>

