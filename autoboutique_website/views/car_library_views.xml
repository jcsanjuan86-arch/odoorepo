<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_library_list" model="ir.ui.view">
        <field name="name">autoboutique.car.library.list</field>
        <field name="model">autoboutique.car.library</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" options="{'size': [80, 50]}" string="Photo"/>
                <field name="make"/>
                <field name="model"/>
                <field name="variant"/>
                <field name="color_ids" widget="many2many_tags" string="Colours"/>
            </list>
        </field>
    </record>

    <record id="view_car_library_kanban" model="ir.ui.view">
        <field name="name">autoboutique.car.library.kanban</field>
        <field name="model">autoboutique.car.library</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="image" widget="image" options="{'size': [220, 130]}" class="text-center"/>
                        <field name="name" class="fw-bold"/>
                        <field name="color_ids" widget="many2many_tags"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_car_library_form" model="ir.ui.view">
        <field name="name">autoboutique.car.library.form</field>
        <field name="model">autoboutique.car.library</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1" placeholder="Make Model"/></h1></div>
                    <group>
                        <group>
                            <field name="make" placeholder="e.g. Toyota"/>
                            <field name="model" placeholder="e.g. Vios"/>
                            <field name="variant"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="tagline"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Colours" name="colors">
                            <field name="color_ids" mode="kanban">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <field name="image" widget="image" options="{'size': [200, 120]}" class="text-center"/>
                                            <div><field name="hex_code" widget="color" class="me-2"/><field name="name" class="fw-bold"/></div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name" placeholder="e.g. White"/>
                                            <field name="hex_code" widget="color"/>
                                            <field name="sequence"/>
                                        </group>
                                        <group>
                                            <field name="image" widget="image" options="{'size': [240, 150]}"/>
                                            <field name="card_image" widget="image" options="{'size': [240, 150]}"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Feature Rows" name="features">
                            <field name="feature_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="text"/>
                                    <field name="image" widget="image" options="{'size': [80, 50]}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_car_library_search" model="ir.ui.view">
        <field name="name">autoboutique.car.library.search</field>
        <field name="model">autoboutique.car.library</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="make"/>
                <field name="model"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group><filter name="group_make" string="Brand" context="{'group_by': 'make'}"/></group>
            </search>
        </field>
    </record>

    <record id="action_car_library" model="ir.actions.act_window">
        <field name="name">Car Library</field>
        <field name="res_model">autoboutique.car.library</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a model once, with a cut-out per colour</p>
            <p>Cars on the Vehicle Master with the same make, model and colour then get these photos and feature rows on the website, with nothing to upload per car.</p>
        </field>
    </record>

    <menuitem id="menu_car_library" name="Car Library" parent="autoboutique_ops.menu_root" action="action_car_library" sequence="36"/>

    <!-- Vehicle Master, Website tab: pick the library model and colour -->
    <record id="view_vehicle_form_car_library" model="ir.ui.view">
        <field name="name">autoboutique.vehicle.form.car.library</field>
        <field name="model">autoboutique.vehicle</field>
        <field name="inherit_id" ref="view_vehicle_form_website"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='Photos']" position="before">
                <group string="Car Library" name="car_library">
                    <group>
                        <field name="library_id" options="{'no_create': True}"/>
                        <field name="library_color_id" options="{'no_create': True}" invisible="not library_id"/>
                    </group>
                    <group>
                        <button name="action_apply_library" type="object" string="Use Library Photos" icon="fa-picture-o"
                                class="btn-secondary" invisible="not library_color_id" colspan="2"
                                confirm="Replace this car's cut-out and listing photo with the library photos?"/>
                        <div class="text-muted" colspan="2">Picked from make, model and colour. The photos below fill themselves; upload only to use your own shots.</div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
