<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- These pages are linked to the Autoboutique Website by post_init_hook. -->
    <template id="homepage" inherit_id="website.homepage" name="Autoboutique Homepage" priority="90">
        <xpath expr="//div[@id='wrap']" position="after">
            <div id="wrap" t-if="website.company_id.name == 'Autoboutique'" class="ab-site">
                <section class="ab-hero"><div class="container ab-hero__content">
                    <p class="ab-eyebrow">AUTO BOUTIQUE</p><h1>Move beyond<br/>ordinary.</h1>
                    <p>Premium pre-owned vehicles, inspected with care and presented with complete transparency.</p>
                    <div class="ab-actions"><a class="btn ab-btn" href="/vehicles">Explore vehicles</a><a class="ab-link" href="/about">Discover Autoboutique <span>→</span></a></div>
                </div></section>
                <section class="ab-trust"><div class="container"><div class="row g-4">
                    <div class="col-6 col-lg-3"><strong>01</strong><span>Curated vehicles<small>Quality units, thoughtfully selected</small></span></div>
                    <div class="col-6 col-lg-3"><strong>02</strong><span>Verified process<small>Clear inspection and documentation</small></span></div>
                    <div class="col-6 col-lg-3"><strong>03</strong><span>Flexible options<small>Support for your preferred purchase plan</small></span></div>
                    <div class="col-6 col-lg-3"><strong>04</strong><span>Confident handover<small>Guided from selection to release</small></span></div>
                </div></div></section>
                <section class="container ab-intro"><p class="ab-eyebrow">THE AUTO BOUTIQUE EXPERIENCE</p><h2>Your next vehicle,<br/>without the uncertainty.</h2>
                    <div class="row g-4 mt-4"><div class="col-md-4"><article class="ab-card"><h3>Explore Vehicles</h3><p>Browse available cars, SUVs, vans, and special finds.</p><a href="/vehicles">Browse inventory →</a></article></div><div class="col-md-4"><article class="ab-card"><h3>Financing Support</h3><p>See practical payment and acquisition options for your next unit.</p><a href="/financing">Explore options →</a></article></div><div class="col-md-4"><article class="ab-card"><h3>After-Sales Care</h3><p>Detailing, documentation, and professional vehicle support.</p><a href="/services">View services →</a></article></div></div>
                </section>
                <section class="ab-feature"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-6"><p class="ab-eyebrow">WHY AUTO BOUTIQUE</p><h2>Every car has a story.<br/>We make it a good one.</h2><p>Our operational workflow connects acquisition, inspection, repair, detailing, documentation, and release—so every vehicle is prepared before it reaches you.</p><a class="btn ab-btn" href="/about">About our process</a></div><div class="col-lg-6"><div class="ab-feature__panel"><span>INSPECTED</span><b>Vehicle-ready process</b><p>Inspection · repair assessment · detailing · final release</p></div></div></div></div></section>
                <section class="container ab-cta"><p class="ab-eyebrow">READY WHEN YOU ARE</p><h2>Find a vehicle that fits your life.</h2><a class="btn ab-btn" href="/vehicles">Browse all vehicles</a></section>
            </div>
        </xpath>
    </template>
    <!-- The public homepage is the website-specific page below, not a global override. -->
    <record id="homepage" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="page_home" model="website.page">
        <field name="name">Autoboutique Home</field><field name="url">/</field><field name="type">qweb</field>
        <field name="is_published" eval="True"/><field name="key">autoboutique_website.home</field>
        <field name="arch" type="xml"><t t-name="autoboutique_website.home"><t t-call="website.layout">
            <div id="wrap" class="ab-site">
                <section class="ab-hero"><div class="container ab-hero__content">
                    <p class="ab-eyebrow">AUTO BOUTIQUE</p><h1>Move beyond<br/>ordinary.</h1>
                    <p>Premium pre-owned vehicles, inspected with care and presented with complete transparency.</p>
                    <div class="ab-actions"><a class="btn ab-btn" href="/vehicles">Explore vehicles</a><a class="ab-link" href="/about">Discover Autoboutique <span>→</span></a></div>
                </div></section>
                <section class="ab-trust"><div class="container"><div class="row g-4">
                    <div class="col-6 col-lg-3"><strong>01</strong><span>Curated vehicles<small>Quality units, thoughtfully selected</small></span></div>
                    <div class="col-6 col-lg-3"><strong>02</strong><span>Verified process<small>Clear inspection and documentation</small></span></div>
                    <div class="col-6 col-lg-3"><strong>03</strong><span>Flexible options<small>Support for your preferred purchase plan</small></span></div>
                    <div class="col-6 col-lg-3"><strong>04</strong><span>Confident handover<small>Guided from selection to release</small></span></div>
                </div></div></section>
                <section class="container ab-intro"><p class="ab-eyebrow">THE AUTO BOUTIQUE EXPERIENCE</p><h2>Your next vehicle,<br/>without the uncertainty.</h2>
                    <div class="row g-4 mt-4"><div class="col-md-4"><article class="ab-card"><h3>Explore Vehicles</h3><p>Browse available cars, SUVs, vans, and special finds.</p><a href="/vehicles">Browse inventory →</a></article></div><div class="col-md-4"><article class="ab-card"><h3>Financing Support</h3><p>See practical payment and acquisition options for your next unit.</p><a href="/financing">Explore options →</a></article></div><div class="col-md-4"><article class="ab-card"><h3>After-Sales Care</h3><p>Detailing, documentation, and professional vehicle support.</p><a href="/services">View services →</a></article></div></div>
                </section>
                <section class="ab-feature"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-6"><p class="ab-eyebrow">WHY AUTO BOUTIQUE</p><h2>Every car has a story.<br/>We make it a good one.</h2><p>Our operational workflow connects acquisition, inspection, repair, detailing, documentation, and release—so every vehicle is prepared before it reaches you.</p><a class="btn ab-btn" href="/about">About our process</a></div><div class="col-lg-6"><div class="ab-feature__panel"><span>INSPECTED</span><b>Vehicle-ready process</b><p>Inspection · repair assessment · detailing · final release</p></div></div></div></div></section>
                <section class="container ab-cta"><p class="ab-eyebrow">READY WHEN YOU ARE</p><h2>Find a vehicle that fits your life.</h2><a class="btn ab-btn" href="/vehicles">Browse all vehicles</a></section>
            </div>
        </t></t></field>
    </record>
    <record id="page_vehicles" model="website.page"><field name="name">Vehicles</field><field name="url">/vehicles</field><field name="type">qweb</field><field name="is_published" eval="True"/><field name="key">autoboutique_website.vehicles</field><field name="arch" type="xml"><t t-name="autoboutique_website.vehicles"><t t-call="website.layout"><div id="wrap" class="ab-site"><section class="ab-page-hero"><div class="container"><p class="ab-eyebrow">AUTOBOUTIQUE INVENTORY</p><h1>Explore vehicles.</h1><p>Browse current vehicle listings and enquire with our team.</p></div></section><section class="container ab-content"><div class="ab-shop-callout"><h2>Available vehicles</h2><p>Our vehicle inventory is updated from Autoboutique Vehicle Master records as units become ready for sale.</p><a class="btn ab-btn" href="/shop">Open vehicle inventory</a></div></section></div></t></t></field></record>
    <record id="page_financing" model="website.page"><field name="name">Financing</field><field name="url">/financing</field><field name="type">qweb</field><field name="is_published" eval="True"/><field name="key">autoboutique_website.financing</field><field name="arch" type="xml"><t t-name="autoboutique_website.financing"><t t-call="website.layout"><div id="wrap" class="ab-site"><section class="ab-page-hero"><div class="container"><p class="ab-eyebrow">FINANCING</p><h1>Plan with confidence.</h1><p>Flexible acquisition options designed around your vehicle goals.</p></div></section><section class="container ab-content"><div class="row g-4"><div class="col-md-4"><article class="ab-card"><h3>Vehicle acquisition</h3><p>Discuss the right unit, price range, and reservation path with our team.</p></article></div><div class="col-md-4"><article class="ab-card"><h3>Installment planning</h3><p>Understand payment terms and the documents required before you commit.</p></article></div><div class="col-md-4"><article class="ab-card"><h3>Transparent release</h3><p>We coordinate unit readiness, payment confirmation, and handover documentation.</p></article></div></div></section></div></t></t></field></record>
    <record id="page_services" model="website.page"><field name="name">Services</field><field name="url">/services</field><field name="type">qweb</field><field name="is_published" eval="True"/><field name="key">autoboutique_website.services</field><field name="arch" type="xml"><t t-name="autoboutique_website.services"><t t-call="website.layout"><div id="wrap" class="ab-site"><section class="ab-page-hero"><div class="container"><p class="ab-eyebrow">AUTO SERVICES</p><h1>Care beyond the sale.</h1><p>Practical vehicle support from assessment to a ready-for-road handover.</p></div></section><section class="container ab-content"><div class="row g-4"><div class="col-md-4"><article class="ab-card"><h3>Inspection &amp; assessment</h3><p>Vehicle quality checks and a clear repair assessment before release.</p></article></div><div class="col-md-4"><article class="ab-card"><h3>Repair &amp; detailing</h3><p>Parts, labor, repair completion, detailing, and final quality control.</p></article></div><div class="col-md-4"><article class="ab-card"><h3>Documentation support</h3><p>Guidance for registration, insurance, and release documents.</p></article></div></div></section></div></t></t></field></record>
    <record id="page_release" model="website.page"><field name="name">Unit Release</field><field name="url">/unit-release</field><field name="type">qweb</field><field name="is_published" eval="True"/><field name="key">autoboutique_website.release</field><field name="arch" type="xml"><t t-name="autoboutique_website.release"><t t-call="website.layout"><div id="wrap" class="ab-site"><section class="ab-page-hero"><div class="container"><p class="ab-eyebrow">UNIT RELEASE</p><h1>A seamless handover.</h1><p>Every final step is coordinated before your vehicle is released.</p></div></section><section class="container ab-content"><ol class="ab-steps"><li><b>Final quality check</b><span>Vehicle condition, detailing, and final readiness are confirmed.</span></li><li><b>Payment confirmation</b><span>Your payment and sales documentation are completed.</span></li><li><b>Documents verified</b><span>Required registration, insurance, and release documents are reviewed.</span></li><li><b>Vehicle handover</b><span>Collect your vehicle with a clear, complete release process.</span></li></ol></section></div></t></t></field></record>
    <record id="page_faqs" model="website.page"><field name="name">FAQs</field><field name="url">/faqs</field><field name="type">qweb</field><field name="is_published" eval="True"/><field name="key">autoboutique_website.faqs</field><field name="arch" type="xml"><t t-name="autoboutique_website.faqs"><t t-call="website.layout"><div id="wrap" class="ab-site"><section class="ab-page-hero"><div class="container"><p class="ab-eyebrow">FREQUENTLY ASKED QUESTIONS</p><h1>Answers, clearly.</h1><p>The essentials for vehicle enquiries, reservation, release, and documents.</p></div></section><section class="container ab-content"><div class="ab-faq"><h3>Are vehicles inspected before sale?</h3><p>Yes. Autoboutique uses a structured process covering inspection, repairs where required, detailing, and a final quality check.</p><h3>Can I reserve a vehicle?</h3><p>Yes. Our team will guide you through availability, reservation, and the required documents.</p><h3>What happens before release?</h3><p>Payment, vehicle readiness, and required documents are confirmed before the handover.</p><h3>Can you help with financing?</h3><p>Yes. Speak with our team about the options that match your planned acquisition.</p></div></section></div></t></t></field></record>
    <record id="page_about" model="website.page"><field name="name">About Autoboutique</field><field name="url">/about</field><field name="type">qweb</field><field name="is_published" eval="True"/><field name="key">autoboutique_website.about</field><field name="arch" type="xml"><t t-name="autoboutique_website.about"><t t-call="website.layout"><div id="wrap" class="ab-site"><section class="ab-page-hero"><div class="container"><p class="ab-eyebrow">ABOUT AUTO BOUTIQUE</p><h1>Premium vehicles.<br/>Prepared properly.</h1><p>Autoboutique brings together vehicle selection, operational quality control, customer support, and a smooth release journey.</p></div></section><section class="container ab-content"><div class="row g-5"><div class="col-lg-6"><h2>Our commitment</h2><p>We believe buying a vehicle should feel considered and confident. That is why each unit follows a defined operational path from acquisition to final release.</p></div><div class="col-lg-6"><h2>What we focus on</h2><p>Quality checks, real cost visibility, completed repair and detailing work, clear documents, and a customer-ready handover.</p></div></div></section></div></t></t></field></record>
    <record id="menu_vehicles" model="website.menu"><field name="name">Vehicles</field><field name="url">/vehicles</field><field name="parent_id" ref="website.main_menu"/><field name="sequence" eval="10"/></record>
    <record id="menu_financing" model="website.menu"><field name="name">Financing</field><field name="url">/financing</field><field name="parent_id" ref="website.main_menu"/><field name="sequence" eval="20"/></record>
    <record id="menu_services" model="website.menu"><field name="name">Services</field><field name="url">/services</field><field name="parent_id" ref="website.main_menu"/><field name="sequence" eval="30"/></record>
    <record id="menu_release" model="website.menu"><field name="name">Unit Release</field><field name="url">/unit-release</field><field name="parent_id" ref="website.main_menu"/><field name="sequence" eval="40"/></record>
    <record id="menu_faqs" model="website.menu"><field name="name">FAQs</field><field name="url">/faqs</field><field name="parent_id" ref="website.main_menu"/><field name="sequence" eval="50"/></record>
    <record id="menu_about" model="website.menu"><field name="name">About</field><field name="url">/about</field><field name="parent_id" ref="website.main_menu"/><field name="sequence" eval="60"/></record>
    <function model="website" name="autoboutique_sync_websites"/>
</odoo>
