<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Job roles. Every role is an internal user, which gives the Autoboutique app and the
         Vehicle Master; the implied groups add the other apps the job needs. -->
    <record id="group_role_operations" model="res.groups">
        <field name="name">Autoboutique Role: Operations Manager</field>
        <field name="comment">Bid lots to release: Vehicle Master, receiving, inventory and purchase approvals.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_manager')), (4, ref('purchase.group_purchase_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="group_role_qaqc" model="res.groups">
        <field name="name">Autoboutique Role: QA/QC Inspector</field>
        <field name="comment">Vehicle Master, QC inspections, repair assessments and detailing.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_role_purchaser" model="res.groups">
        <field name="name">Autoboutique Role: Purchaser</field>
        <field name="comment">Vehicle Master, bid lots, material requests, RFQs and purchase orders, receipts.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('purchase.group_purchase_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_role_document_controller" model="res.groups">
        <field name="name">Autoboutique Role: Document Controller</field>
        <field name="comment">Vehicle Master, document tracking, registrations (OR/CR, plates) and insurance.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_role_accounting_staff" model="res.groups">
        <field name="name">Autoboutique Role: Accounting Staff</field>
        <field name="comment">Vehicle Master, customer invoices, vendor bills and payments.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_role_finance_supervisor" model="res.groups">
        <field name="name">Autoboutique Role: Finance Supervisor</field>
        <field name="comment">Vehicle Master and full accounting (journal entries, reconciliation, reports).</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_user')), (4, ref('purchase.group_purchase_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="group_role_accounting_head" model="res.groups">
        <field name="name">Autoboutique Role: Accounting Head</field>
        <field name="comment">Vehicle Master and accounting administration (chart of accounts, taxes, lock dates).</field>
        <field name="implied_ids" eval="[(4, ref('group_role_finance_supervisor')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <record id="group_role_sales_head" model="res.groups">
        <field name="name">Autoboutique Role: Sales Head</field>
        <field name="comment">Vehicle Master, sales applications, quotations and orders of all salespeople, commissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>
</odoo>
