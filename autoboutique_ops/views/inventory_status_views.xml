<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_form_inventory_status" model="ir.ui.view">
        <field name="name">autoboutique.vehicle.form.inventory.status</field>
        <field name="model">autoboutique.vehicle</field>
        <field name="inherit_id" ref="view_vehicle_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Inventory Status" name="inventory_status">
                    <group>
                        <group string="Unit">
                            <field name="stock_owner"/>
                            <field name="location"/>
                            <field name="marketing_status"/>
                            <field name="bank_from"/>
                            <field name="bidder"/>
                            <field name="operations_remarks"/>
                        </group>
                        <group string="Price and Monthly Amortization">
                            <field name="selling_price"/>
                            <field name="downpayment"/>
                            <field name="amortization_3y"/>
                            <field name="amortization_4y"/>
                            <field name="amortization_5y"/>
                        </group>
                        <group string="Papers">
                            <field name="papers"/>
                            <field name="paper_status"/>
                            <field name="plate_status"/>
                            <field name="transfer_status"/>
                            <field name="inventory_remarks"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- The Vehicle Master is the one place to update a car: its list carries the sheet's columns
         (select rows to edit several at once) and its form has the Inventory Status tab. -->
    <record id="view_vehicle_list_inventory_status" model="ir.ui.view">
        <field name="name">autoboutique.vehicle.list.inventory.status</field>
        <field name="model">autoboutique.vehicle</field>
        <field name="inherit_id" ref="view_vehicle_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="stock_owner" optional="show"/>
                <field name="location" optional="show"/>
                <field name="marketing_status" optional="show"/>
                <field name="selling_price" optional="show" sum="Total"/>
                <field name="downpayment" optional="show"/>
                <field name="amortization_3y" optional="hide"/>
                <field name="amortization_4y" optional="hide"/>
                <field name="amortization_5y" optional="hide"/>
                <field name="customer_id" optional="hide"/>
                <field name="sales_agent_id" optional="hide"/>
                <field name="financing_bank" optional="hide"/>
                <field name="bank_from" optional="hide"/>
                <field name="bidder" optional="hide"/>
                <field name="mileage" optional="hide"/>
                <field name="operations_remarks" optional="hide"/>
                <field name="papers" optional="show"/>
                <field name="paper_status" optional="hide"/>
                <field name="plate_status" optional="hide"/>
                <field name="transfer_status" optional="hide"/>
                <field name="inventory_remarks" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_vehicle_search" model="ir.ui.view">
        <field name="name">autoboutique.vehicle.search</field>
        <field name="model">autoboutique.vehicle</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plate_number"/>
                <field name="vin"/>
                <field name="bidder"/>
                <filter name="in_stock" string="In Stock"
                        domain="[('state', 'in', ('receiving', 'qc', 'repair', 'detailing', 'ready', 'reserved'))]"/>
                <filter name="autoboutique" string="Auto Boutique" domain="[('stock_owner', '=', 'autoboutique')]"/>
                <filter name="bdo" string="BDO" domain="[('stock_owner', '=', 'bdo')]"/>
                <filter name="to_shoot" string="To Shoot" domain="[('marketing_status', '=', 'to_shoot')]"/>
                <filter name="without_papers" string="Without Papers" domain="[('papers', '=', 'without')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_make" string="Brand" context="{'group_by': 'make'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                    <filter name="group_owner" string="Inventory Of" context="{'group_by': 'stock_owner'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_inventory_status_dashboard" model="ir.actions.client">
        <field name="name">Inventory Status</field>
        <field name="tag">autoboutique_financing_report</field>
        <field name="params" eval="{'tab': 'inventory', 'model': 'autoboutique.vehicle'}"/>
    </record>

    <menuitem id="menu_inventory_status" name="Inventory Status" parent="menu_root" sequence="2"
              action="action_inventory_status_dashboard"
              groups="group_role_operations,group_role_finance_supervisor,group_role_sales_head,base.group_system"/>
</odoo>
