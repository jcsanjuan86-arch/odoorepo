<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One checklist line: opened from the inspection to add photos -->
    <record id="view_qc_line_form" model="ir.ui.view">
        <field name="name">autoboutique.qc.line.form</field>
        <field name="model">autoboutique.qc.line</field>
        <field name="arch" type="xml">
            <form string="Inspection Point">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="section" readonly="1"/>
                        <field name="tick_ok"/>
                        <field name="tick_attention"/>
                        <field name="tick_na"/>
                        <field name="status" invisible="1"/>
                        <field name="remarks"/>
                    </group>
                    <group string="Repair" invisible="not repair_line_ids">
                        <field name="repair_line_ids" nolabel="1" colspan="2" readonly="1">
                            <list><field name="repair_id"/><field name="name"/><field name="cost_type"/><field name="product_id"/><field name="estimated_cost"/></list>
                        </field>
                    </group>
                    <group string="Photos">
                        <field name="photo" widget="image"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- The checklist on the QC inspection, one tab per section -->
    <record id="view_qc_form_checklist" model="ir.ui.view">
        <field name="name">autoboutique.qc.form.checklist</field>
        <field name="model">autoboutique.qc</field>
        <field name="inherit_id" ref="view_qc_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_checklist" type="object" string="Print Checklist" icon="fa-print" invisible="not line_ids"/>
                <button name="action_load_checklist" type="object" string="Load Checklist" invisible="line_ids"/>
            </xpath>
            <xpath expr="//sheet/group" position="before">
                <div class="alert alert-info mb-2" role="status" invisible="not checklist_unchecked_count">
                    Tick OK, Needs Attention or N/A on every inspection point in each tab below.
                    The result (Pass or Fail) can only be set once no point is left unticked.
                </div>
                <div class="alert alert-warning mb-2" role="alert" invisible="not checklist_attention_count">
                    Some points need attention. They are copied to the findings and the repair assessment
                    when the result is recorded.
                </div>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <field name="line_ids" invisible="1"/>
                <group col="4" invisible="not line_ids">
                    <field name="checklist_ok_count"/>
                    <field name="checklist_attention_count" string="Needs Attention"/>
                    <field name="checklist_na_count"/>
                    <field name="checklist_unchecked_count"/>
                </group>
                <notebook invisible="not line_ids">
                    <page string="PMS" name="qc_pms">
                        <field name="pms_line_ids" context="{'default_section': 'pms'}" nolabel="1">
                            <list editable="bottom" open_form_view="1" decoration-danger="status == 'attention'" decoration-success="status == 'ok'" decoration-muted="status == 'na'">
                                <field name="sequence" widget="handle"/>
                                <field name="section" column_invisible="1"/>
                                <field name="status" column_invisible="1"/>
                                <field name="name"/>
                                <field name="tick_ok"/>
                                <field name="tick_attention"/>
                                <field name="tick_na"/>
                                <field name="remarks"/>
                                <field name="photo" widget="image" options="{'size': [40, 40]}"/>
                                <field name="repair_status" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Engine" name="qc_engine">
                        <field name="engine_line_ids" context="{'default_section': 'engine'}" nolabel="1">
                            <list editable="bottom" open_form_view="1" decoration-danger="status == 'attention'" decoration-success="status == 'ok'" decoration-muted="status == 'na'">
                                <field name="sequence" widget="handle"/>
                                <field name="section" column_invisible="1"/>
                                <field name="status" column_invisible="1"/>
                                <field name="name"/>
                                <field name="tick_ok"/>
                                <field name="tick_attention"/>
                                <field name="tick_na"/>
                                <field name="remarks"/>
                                <field name="photo" widget="image" options="{'size': [40, 40]}"/>
                                <field name="repair_status" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Underchassis" name="qc_underchassis">
                        <field name="underchassis_line_ids" context="{'default_section': 'underchassis'}" nolabel="1">
                            <list editable="bottom" open_form_view="1" decoration-danger="status == 'attention'" decoration-success="status == 'ok'" decoration-muted="status == 'na'">
                                <field name="sequence" widget="handle"/>
                                <field name="section" column_invisible="1"/>
                                <field name="status" column_invisible="1"/>
                                <field name="name"/>
                                <field name="tick_ok"/>
                                <field name="tick_attention"/>
                                <field name="tick_na"/>
                                <field name="remarks"/>
                                <field name="photo" widget="image" options="{'size': [40, 40]}"/>
                                <field name="repair_status" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Transmission" name="qc_transmission">
                        <field name="transmission_line_ids" context="{'default_section': 'transmission'}" nolabel="1">
                            <list editable="bottom" open_form_view="1" decoration-danger="status == 'attention'" decoration-success="status == 'ok'" decoration-muted="status == 'na'">
                                <field name="sequence" widget="handle"/>
                                <field name="section" column_invisible="1"/>
                                <field name="status" column_invisible="1"/>
                                <field name="name"/>
                                <field name="tick_ok"/>
                                <field name="tick_attention"/>
                                <field name="tick_na"/>
                                <field name="remarks"/>
                                <field name="photo" widget="image" options="{'size': [40, 40]}"/>
                                <field name="repair_status" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Electrical" name="qc_electrical">
                        <field name="electrical_line_ids" context="{'default_section': 'electrical'}" nolabel="1">
                            <list editable="bottom" open_form_view="1" decoration-danger="status == 'attention'" decoration-success="status == 'ok'" decoration-muted="status == 'na'">
                                <field name="sequence" widget="handle"/>
                                <field name="section" column_invisible="1"/>
                                <field name="status" column_invisible="1"/>
                                <field name="name"/>
                                <field name="tick_ok"/>
                                <field name="tick_attention"/>
                                <field name="tick_na"/>
                                <field name="remarks"/>
                                <field name="photo" widget="image" options="{'size': [40, 40]}"/>
                                <field name="repair_status" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Aircon" name="qc_aircon">
                        <field name="aircon_line_ids" context="{'default_section': 'aircon'}" nolabel="1">
                            <list editable="bottom" open_form_view="1" decoration-danger="status == 'attention'" decoration-success="status == 'ok'" decoration-muted="status == 'na'">
                                <field name="sequence" widget="handle"/>
                                <field name="section" column_invisible="1"/>
                                <field name="status" column_invisible="1"/>
                                <field name="name"/>
                                <field name="tick_ok"/>
                                <field name="tick_attention"/>
                                <field name="tick_na"/>
                                <field name="remarks"/>
                                <field name="photo" widget="image" options="{'size': [40, 40]}"/>
                                <field name="repair_status" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Body &amp; Paint" name="qc_body">
                        <field name="body_line_ids" context="{'default_section': 'body'}" nolabel="1">
                            <list editable="bottom" open_form_view="1" decoration-danger="status == 'attention'" decoration-success="status == 'ok'" decoration-muted="status == 'na'">
                                <field name="sequence" widget="handle"/>
                                <field name="section" column_invisible="1"/>
                                <field name="status" column_invisible="1"/>
                                <field name="name"/>
                                <field name="tick_ok"/>
                                <field name="tick_attention"/>
                                <field name="tick_na"/>
                                <field name="remarks"/>
                                <field name="photo" widget="image" options="{'size': [40, 40]}"/>
                                <field name="repair_status" optional="show"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Car photo on the Vehicle Master -->
    <record id="view_vehicle_form_photo" model="ir.ui.view">
        <field name="name">autoboutique.vehicle.form.photo</field>
        <field name="model">autoboutique.vehicle</field>
        <field name="inherit_id" ref="view_vehicle_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_256'}"/>
            </xpath>
        </field>
    </record>

    <!-- Repair lines show the checklist point they fix; material request items show stock on hand -->
    <record id="view_repair_form_checklist" model="ir.ui.view">
        <field name="name">autoboutique.repair.form.checklist</field>
        <field name="model">autoboutique.repair</field>
        <field name="inherit_id" ref="view_repair_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="after">
                <field name="qc_line_id" optional="show" options="{'no_create': True}" domain="[('qc_id.vehicle_id', '=', parent.vehicle_id), ('status', '=', 'attention')]"/>
            </xpath>
        </field>
    </record>
    <record id="view_mrf_form_availability" model="ir.ui.view">
        <field name="name">autoboutique.mrf.form.availability</field>
        <field name="model">autoboutique.mrf</field>
        <field name="inherit_id" ref="view_mrf_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='item_ids']/list/field[@name='quantity']" position="after">
                <field name="qty_available"/>
            </xpath>
        </field>
    </record>

    <record id="view_qc_list_checklist" model="ir.ui.view">
        <field name="name">autoboutique.qc.list.checklist</field>
        <field name="model">autoboutique.qc</field>
        <field name="inherit_id" ref="view_qc_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='result']" position="after">
                <field name="checklist_attention_count" string="Needs Attention" optional="show"/>
                <field name="checklist_unchecked_count" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Configuration: the checklist items every new inspection starts with -->
    <record id="view_qc_checklist_item_list" model="ir.ui.view">
        <field name="name">autoboutique.qc.checklist.item.list</field>
        <field name="model">autoboutique.qc.checklist.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="section"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_qc_checklist_item_search" model="ir.ui.view">
        <field name="name">autoboutique.qc.checklist.item.search</field>
        <field name="model">autoboutique.qc.checklist.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group><filter name="group_section" string="Section" context="{'group_by': 'section'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_qc_checklist_items" model="ir.actions.act_window">
        <field name="name">QC Checklist Items</field>
        <field name="res_model">autoboutique.qc.checklist.item</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_section': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Add an inspection point</p><p>New QC inspections start with every active item. Archive items you no longer check.</p></field>
    </record>
    <menuitem id="menu_configuration" name="Configuration" parent="menu_root" sequence="100" groups="base.group_system"/>
    <menuitem id="menu_qc_checklist_items" name="QC Checklist Items" parent="menu_configuration" action="action_qc_checklist_items" sequence="10"/>
</odoo>
