<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Accounts: the monthly tabs of the tracker, as one sheet with a month filter. -->
    <record id="view_financing_account_list" model="ir.ui.view">
        <field name="name">autoboutique.financing.account.list</field>
        <field name="model">autoboutique.financing.account</field>
        <field name="arch" type="xml">
            <list editable="bottom" open_form_view="True" multi_edit="1" decoration-success="status == 'released'"
                  decoration-info="status in ('approved', 'for_release')"
                  decoration-muted="status in ('decline', 'cmap_low', 'cancelled', 'cancelled_approved', 'cancelled_unresponsive')">
                <field name="date"/>
                <field name="name"/>
                <field name="vehicle_id" optional="show"/>
                <field name="plate_number" optional="show"/>
                <field name="unit"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <field name="amount_approved" sum="Total"/>
                <field name="status"/>
                <field name="officer_id"/>
                <field name="days_open" optional="show"/>
                <field name="submission_summary" optional="show"/>
                <field name="remarks" optional="show"/>
                <field name="inhouse_remarks" optional="show"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_financing_account_form" model="ir.ui.view">
        <field name="name">autoboutique.financing.account.form</field>
        <field name="model">autoboutique.financing.account</field>
        <field name="arch" type="xml">
            <form string="Financing Account">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"
                           statusbar_visible="for_interview,for_approval,approved,for_release,released"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="status != 'released' or (bank_id and amount_approved)">
                        Released without a bank or amount. Enter both so the reports count this account correctly.
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="customer_id"/>
                            <field name="email"/>
                            <field name="vehicle_id"/>
                            <field name="plate_number"/>
                            <field name="unit"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source"/>
                            <field name="bank_id"/>
                            <field name="officer_id"/>
                            <field name="amount_approved"/>
                            <field name="days_open"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                        <field name="inhouse_remarks"/>
                    </group>
                    <notebook>
                        <page string="Bank Submissions" name="submissions">
                            <field name="submission_ids">
                                <list editable="bottom">
                                    <field name="bank_id"/>
                                    <field name="officer_id"/>
                                    <field name="date_submitted"/>
                                    <field name="aging"/>
                                    <field name="result"/>
                                    <field name="date_result"/>
                                    <field name="amount_approved"/>
                                    <field name="remarks"/>
                                    <field name="inhouse_remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Release" name="release">
                            <group>
                                <group>
                                    <field name="release_date"/>
                                    <field name="proceed_amount"/>
                                    <field name="transfer_status"/>
                                    <field name="due_date"/>
                                </group>
                                <group>
                                    <field name="chattel_fee"/>
                                    <field name="chattel_date"/>
                                    <field name="no_b"/>
                                    <field name="no_cb"/>
                                </group>
                            </group>
                            <group><field name="released_remarks"/></group>
                        </page>
                        <page string="Process" name="process">
                            <group>
                                <field name="sales_application_id"/>
                                <field name="invoice_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_financing_account_search" model="ir.ui.view">
        <field name="name">autoboutique.financing.account.search</field>
        <field name="model">autoboutique.financing.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plate_number"/>
                <field name="unit"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <field name="officer_id"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(day=1, months=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="month" string="Date" date="date"/>
                <separator/>
                <filter name="on_process" string="On Process"
                        domain="[('status', 'in', ('checking_docs', 'hold_lacking', 'for_interview', 'for_ci', 'for_cam', 'for_approval'))]"/>
                <filter name="approved" string="Approved" domain="[('status', 'in', ('approved', 'for_release'))]"/>
                <filter name="released" string="Released" domain="[('status', '=', 'released')]"/>
                <filter name="incomplete_release" string="Released, Missing Details"
                        domain="[('status', '=', 'released'), '|', ('bank_id', '=', False), ('amount_approved', '=', 0)]"/>
                <filter name="lost" string="Lost"
                        domain="[('status', 'in', ('decline', 'cmap_low', 'cancelled', 'cancelled_approved', 'cancelled_unresponsive'))]"/>
                <group>
                    <filter name="by_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="by_bank" string="Financing" context="{'group_by': 'bank_id'}"/>
                    <filter name="by_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                </group>
                <searchpanel>
                    <field name="status" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Financing on the Vehicle Master: the buyer's bank and status for everyone, the accounts for Financing. -->
    <record id="view_vehicle_form_financing" model="ir.ui.view">
        <field name="name">autoboutique.vehicle.form.financing</field>
        <field name="model">autoboutique.vehicle</field>
        <field name="inherit_id" ref="view_vehicle_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group/field[@name='supplier_id']" position="after">
                <field name="financing_bank" invisible="not financing_bank"/>
                <field name="financing_status" invisible="not financing_status"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Financing" name="financing">
                    <group>
                        <group>
                            <field name="financing_bank"/>
                            <field name="financing_status"/>
                            <field name="financing_amount"/>
                        </group>
                        <group>
                            <button name="action_view_financing" type="object" string="Open Financing Accounts"
                                    class="btn-secondary" icon="fa-bank" colspan="2"
                                    groups="autoboutique_ops.group_financing"/>
                        </group>
                    </group>
                    <field name="financing_account_ids" readonly="1" groups="autoboutique_ops.group_financing">
                        <list decoration-success="status == 'released'" decoration-info="status in ('approved', 'for_release')"
                              decoration-muted="status in ('decline', 'cmap_low', 'cancelled', 'cancelled_approved', 'cancelled_unresponsive')">
                            <field name="date"/>
                            <field name="name"/>
                            <field name="bank_id"/>
                            <field name="officer_id"/>
                            <field name="amount_approved" sum="Total"/>
                            <field name="status"/>
                            <field name="release_date"/>
                            <field name="proceed_amount"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_financing_accounts" model="ir.actions.act_window">
        <field name="name">Financing Accounts</field>
        <field name="res_model">autoboutique.financing.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>

    <!-- Released: the RELEASED tab. -->
    <record id="view_financing_released_list" model="ir.ui.view">
        <field name="name">autoboutique.financing.account.released.list</field>
        <field name="model">autoboutique.financing.account</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" open_form_view="True">
                <field name="date"/>
                <field name="name" string="Client Name"/>
                <field name="plate_number"/>
                <field name="unit"/>
                <field name="partner_id" string="Partner's Name"/>
                <field name="bank_id"/>
                <field name="amount_approved" string="Finance Amount" sum="Total"/>
                <field name="status"/>
                <field name="proceed_amount" sum="Total"/>
                <field name="transfer_status"/>
                <field name="chattel_fee" sum="Total"/>
                <field name="chattel_date"/>
                <field name="release_date"/>
                <field name="released_remarks"/>
                <field name="due_date"/>
                <field name="no_b"/>
                <field name="no_cb"/>
                <field name="email"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="action_financing_released" model="ir.actions.act_window">
        <field name="name">Released Accounts</field>
        <field name="res_model">autoboutique.financing.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'released')]</field>
        <field name="view_id" ref="view_financing_released_list"/>
    </record>

    <!-- TFS evaluation: the brand new tab. -->
    <record id="view_financing_evaluation_list" model="ir.ui.view">
        <field name="name">autoboutique.financing.evaluation.list</field>
        <field name="model">autoboutique.financing.evaluation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="unit"/>
                <field name="variant"/>
                <field name="engine"/>
                <field name="brand_new_price"/>
                <field name="evaluation_2026"/>
                <field name="evaluation_2025"/>
                <field name="evaluation_2024"/>
                <field name="evaluation_2023"/>
                <field name="approval_2026"/>
                <field name="approval_2025"/>
                <field name="approval_2024"/>
                <field name="approval_2023"/>
            </list>
        </field>
    </record>
    <record id="action_financing_evaluation" model="ir.actions.act_window">
        <field name="name">TFS Evaluation</field>
        <field name="res_model">autoboutique.financing.evaluation</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Unit quotes: the SRP table of the brand new tab. -->
    <record id="view_financing_quote_list" model="ir.ui.view">
        <field name="name">autoboutique.financing.quote.list</field>
        <field name="model">autoboutique.financing.quote</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="unit"/>
                <field name="srp"/>
                <field name="downpayment"/>
                <field name="monthly_amortization"/>
            </list>
        </field>
    </record>
    <record id="action_financing_quote" model="ir.actions.act_window">
        <field name="name">Unit Quotes</field>
        <field name="res_model">autoboutique.financing.quote</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Configuration -->
    <record id="view_financing_bank_list" model="ir.ui.view">
        <field name="name">autoboutique.financing.bank.list</field>
        <field name="model">autoboutique.financing.bank</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="is_cash"/></list></field>
    </record>
    <record id="view_financing_partner_list" model="ir.ui.view">
        <field name="name">autoboutique.financing.partner.list</field>
        <field name="model">autoboutique.financing.partner</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="team"/><field name="source"/><field name="user_id"/></list></field>
    </record>
    <record id="view_financing_officer_list" model="ir.ui.view">
        <field name="name">autoboutique.financing.officer.list</field>
        <field name="model">autoboutique.financing.officer</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="bank_id"/></list></field>
    </record>
    <record id="action_financing_banks" model="ir.actions.act_window"><field name="name">Banks</field><field name="res_model">autoboutique.financing.bank</field><field name="view_mode">list</field></record>
    <record id="action_financing_partners" model="ir.actions.act_window"><field name="name">Partners</field><field name="res_model">autoboutique.financing.partner</field><field name="view_mode">list</field></record>
    <record id="action_financing_officers" model="ir.actions.act_window"><field name="name">Account Officers</field><field name="res_model">autoboutique.financing.officer</field><field name="view_mode">list</field></record>

    <!-- Reports: one menu per tab of the tracker. -->
    <record id="action_financing_daily" model="ir.actions.client"><field name="name">Daily Report</field><field name="tag">autoboutique_financing_report</field><field name="params" eval="{'tab': 'daily'}"/></record>
    <record id="action_financing_monthly" model="ir.actions.client"><field name="name">Monthly Performance</field><field name="tag">autoboutique_financing_report</field><field name="params" eval="{'tab': 'monthly'}"/></record>
    <record id="action_financing_overall" model="ir.actions.client"><field name="name">Overall Monthly</field><field name="tag">autoboutique_financing_report</field><field name="params" eval="{'tab': 'overall'}"/></record>
    <record id="action_financing_average" model="ir.actions.client"><field name="name">Average</field><field name="tag">autoboutique_financing_report</field><field name="params" eval="{'tab': 'average'}"/></record>
    <record id="action_financing_percent" model="ir.actions.client"><field name="name">Financing %</field><field name="tag">autoboutique_financing_report</field><field name="params" eval="{'tab': 'financing'}"/></record>
    <record id="action_financing_quarter" model="ir.actions.client"><field name="name">Quarterly Average</field><field name="tag">autoboutique_financing_report</field><field name="params" eval="{'tab': 'quarter'}"/></record>

    <menuitem id="menu_financing" name="Financing" parent="menu_root" sequence="75" groups="group_financing,base.group_system"/>
    <menuitem id="menu_financing_accounts" name="Accounts" parent="menu_financing" action="action_financing_accounts" sequence="10"/>
    <menuitem id="menu_financing_released" name="Released" parent="menu_financing" action="action_financing_released" sequence="20"/>
    <menuitem id="menu_financing_daily" name="Daily Report" parent="menu_financing" action="action_financing_daily" sequence="30"/>
    <menuitem id="menu_financing_monthly" name="Monthly Performance" parent="menu_financing" action="action_financing_monthly" sequence="40"/>
    <menuitem id="menu_financing_overall" name="Overall Monthly" parent="menu_financing" action="action_financing_overall" sequence="50"/>
    <menuitem id="menu_financing_average" name="Average" parent="menu_financing" action="action_financing_average" sequence="60"/>
    <menuitem id="menu_financing_percent" name="Financing %" parent="menu_financing" action="action_financing_percent" sequence="70"/>
    <menuitem id="menu_financing_quarter" name="Quarterly Average" parent="menu_financing" action="action_financing_quarter" sequence="80"/>
    <menuitem id="menu_financing_evaluation" name="TFS Evaluation" parent="menu_financing" action="action_financing_evaluation" sequence="90"/>
    <menuitem id="menu_financing_quote" name="Unit Quotes" parent="menu_financing" action="action_financing_quote" sequence="95"/>
    <menuitem id="menu_financing_config" name="Configuration" parent="menu_financing" sequence="100"/>
    <menuitem id="menu_financing_banks" name="Banks" parent="menu_financing_config" action="action_financing_banks" sequence="10"/>
    <menuitem id="menu_financing_partners" name="Partners" parent="menu_financing_config" action="action_financing_partners" sequence="20"/>
    <menuitem id="menu_financing_officers" name="Account Officers" parent="menu_financing_config" action="action_financing_officers" sequence="30"/>

    <!-- The sales application opens its account, creating it for a financed buyer. -->
    <record id="view_sales_application_form_financing" model="ir.ui.view">
        <field name="name">autoboutique.sales.application.form.financing</field>
        <field name="model">autoboutique.sales.application</field>
        <field name="inherit_id" ref="view_sales_application_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_open_financing_account" type="object" string="Financing Account"
                        groups="autoboutique_ops.group_financing"/>
            </xpath>
        </field>
    </record>
</odoo>
