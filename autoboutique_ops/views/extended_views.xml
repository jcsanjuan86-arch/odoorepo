<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sales_application_list" model="ir.ui.view"><field name="name">autoboutique.sales.application.list</field><field name="model">autoboutique.sales.application</field><field name="arch" type="xml"><list><field name="name"/><field name="vehicle_id"/><field name="customer_id"/><field name="sales_agent_id"/><field name="selling_price"/><field name="state"/></list></field></record>
    <record id="view_sales_application_form" model="ir.ui.view"><field name="name">autoboutique.sales.application.form</field><field name="model">autoboutique.sales.application</field><field name="arch" type="xml"><form string="Sales Application"><header><button name="action_approve_and_reserve" type="object" string="Approve &amp; Reserve" class="btn-primary" invisible="state not in ('draft', 'approval')"/><field name="state" widget="statusbar" statusbar_visible="draft,approval,approved,reserved,sold,rejected,cancelled"/></header><sheet><group><group><field name="name"/><field name="vehicle_id"/><field name="customer_id"/><field name="sales_agent_id"/><field name="application_date"/></group><group><field name="selling_price"/><field name="requirements_complete"/><field name="reservation_expiry"/><field name="sale_order_id"/></group></group><group string="Approval"><field name="missing_requirements"/><field name="approved_by" readonly="1"/><field name="approved_on" readonly="1"/><field name="rejection_reason"/></group></sheet></form></field></record>

    <record id="view_release_list" model="ir.ui.view"><field name="name">autoboutique.vehicle.release.list</field><field name="model">autoboutique.vehicle.release</field><field name="arch" type="xml"><list><field name="name"/><field name="vehicle_id"/><field name="customer_id"/><field name="sale_order_id"/><field name="invoice_id"/><field name="state"/></list></field></record>
    <record id="view_release_form" model="ir.ui.view"><field name="name">autoboutique.vehicle.release.form</field><field name="model">autoboutique.vehicle.release</field><field name="arch" type="xml"><form string="Vehicle Release"><header><button name="action_approve_release" type="object" string="Approve Release" class="btn-primary" invisible="state != 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,approved,cancelled"/></header><sheet><group><group><field name="name"/><field name="vehicle_id"/><field name="sales_application_id"/><field name="customer_id"/></group><group><field name="sale_order_id"/><field name="invoice_id"/><field name="odometer"/><field name="payment_verified" readonly="1"/></group></group><group string="Release Checklist" col="3"><field name="final_qc_verified"/><field name="detailing_verified"/><field name="documents_verified"/><field name="customer_id_checked"/><field name="keys_handed_over"/><field name="originals_handed_over"/></group><group><field name="approved_by" readonly="1"/><field name="release_date" readonly="1"/><field name="notes"/></group></sheet></form></field></record>

    <record id="view_registration_list" model="ir.ui.view"><field name="name">autoboutique.registration.list</field><field name="model">autoboutique.registration</field><field name="arch" type="xml"><list><field name="name"/><field name="vehicle_id"/><field name="plate_number"/><field name="status"/><field name="completed_date"/></list></field></record>
    <record id="view_registration_form" model="ir.ui.view"><field name="name">autoboutique.registration.form</field><field name="model">autoboutique.registration</field><field name="arch" type="xml"><form><header><button name="action_complete" type="object" string="Complete Registration" class="btn-primary" invisible="status == 'completed'"/><field name="status" widget="statusbar" statusbar_visible="draft,processing,completed"/></header><sheet><group><field name="name"/><field name="vehicle_id"/><field name="customer_id"/><field name="responsible_id"/><field name="submitted_date"/><field name="orcr_status"/><field name="plate_status"/><field name="plate_number"/><field name="documents_complete"/><field name="completed_date" readonly="1"/></group></sheet></form></field></record>

    <record id="view_insurance_list" model="ir.ui.view"><field name="name">autoboutique.insurance.list</field><field name="model">autoboutique.insurance</field><field name="arch" type="xml"><list><field name="name"/><field name="vehicle_id"/><field name="provider_id"/><field name="policy_number"/><field name="expiration_date"/><field name="status"/></list></field></record>
    <record id="view_insurance_form" model="ir.ui.view"><field name="name">autoboutique.insurance.form</field><field name="model">autoboutique.insurance</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="vehicle_id"/><field name="customer_id"/><field name="provider_id"/><field name="policy_number"/><field name="effective_date"/><field name="expiration_date"/><field name="status"/></group></sheet></form></field></record>

    <record id="view_document_list" model="ir.ui.view"><field name="name">autoboutique.document.list</field><field name="model">autoboutique.document</field><field name="arch" type="xml"><list><field name="name"/><field name="vehicle_id"/><field name="document_type"/><field name="required"/><field name="status"/><field name="completed_date"/></list></field></record>
    <record id="view_document_form" model="ir.ui.view"><field name="name">autoboutique.document.form</field><field name="model">autoboutique.document</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="vehicle_id"/><field name="customer_id"/><field name="release_id"/><field name="document_type"/><field name="required"/><field name="status"/><field name="received_date"/><field name="completed_date"/><field name="remarks"/></group></sheet></form></field></record>

    <record id="view_commission_list" model="ir.ui.view"><field name="name">autoboutique.commission.list</field><field name="model">autoboutique.commission</field><field name="arch" type="xml"><list><field name="name"/><field name="sales_agent_id"/><field name="vehicle_id"/><field name="selling_price"/><field name="amount"/><field name="state"/></list></field></record>
    <record id="view_commission_form" model="ir.ui.view"><field name="name">autoboutique.commission.form</field><field name="model">autoboutique.commission</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'"/><button name="action_mark_paid" type="object" string="Mark Paid" class="btn-primary" invisible="state != 'approved'"/><field name="state" widget="statusbar" statusbar_visible="draft,approved,paid,rejected"/></header><sheet><group><group><field name="name"/><field name="sales_agent_id"/><field name="vehicle_id"/><field name="sale_order_id"/><field name="invoice_id"/></group><group><field name="selling_price"/><field name="commission_type"/><field name="rate"/><field name="amount" readonly="1"/><field name="paid" readonly="1"/><field name="paid_date" readonly="1"/></group></group></sheet></form></field></record>

    <record id="view_dashboard_list" model="ir.ui.view"><field name="name">autoboutique.dashboard.list</field><field name="model">autoboutique.dashboard</field><field name="arch" type="xml"><list><field name="name"/><field name="snapshot_date"/><field name="vehicles_total"/><field name="vehicles_ready"/><field name="vehicles_repair"/><field name="vehicles_sold"/><field name="gross_profit"/></list></field></record>
    <record id="view_dashboard_form" model="ir.ui.view"><field name="name">autoboutique.dashboard.form</field><field name="model">autoboutique.dashboard</field><field name="arch" type="xml"><form><header><button name="action_refresh" type="object" string="Refresh KPIs" class="btn-primary"/></header><sheet><group><field name="name"/><field name="snapshot_date"/></group><group string="Vehicle KPIs" col="4"><field name="vehicles_total" readonly="1"/><field name="vehicles_ready" readonly="1"/><field name="vehicles_repair" readonly="1"/><field name="vehicles_sold" readonly="1"/></group><group string="Financial KPIs"><field name="total_vehicle_cost" readonly="1"/><field name="sales_revenue" readonly="1"/><field name="gross_profit" readonly="1"/></group></sheet></form></field></record>

    <record id="action_sales_applications" model="ir.actions.act_window"><field name="name">Sales Applications</field><field name="res_model">autoboutique.sales.application</field><field name="view_mode">list,form</field></record>
    <record id="action_releases" model="ir.actions.act_window"><field name="name">Vehicle Releases</field><field name="res_model">autoboutique.vehicle.release</field><field name="view_mode">list,form</field></record>
    <record id="action_registrations" model="ir.actions.act_window"><field name="name">Vehicle Registrations</field><field name="res_model">autoboutique.registration</field><field name="view_mode">list,form</field></record>
    <record id="action_insurance" model="ir.actions.act_window"><field name="name">Vehicle Insurance</field><field name="res_model">autoboutique.insurance</field><field name="view_mode">list,form</field></record>
    <record id="action_documents" model="ir.actions.act_window"><field name="name">Document Tracking</field><field name="res_model">autoboutique.document</field><field name="view_mode">list,form</field></record>
    <record id="action_commissions" model="ir.actions.act_window"><field name="name">Sales Commissions</field><field name="res_model">autoboutique.commission</field><field name="view_mode">list,form</field></record>
    <record id="action_dashboard" model="ir.actions.act_window"><field name="name">Management Dashboard</field><field name="res_model">autoboutique.dashboard</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_sales_applications" name="Sales Applications" parent="menu_root" action="action_sales_applications" sequence="80"/>
    <menuitem id="menu_releases" name="Vehicle Releases" parent="menu_root" action="action_releases" sequence="90"/>
    <menuitem id="menu_registrations" name="Vehicle Registrations" parent="menu_root" action="action_registrations" sequence="100"/>
    <menuitem id="menu_insurance" name="Vehicle Insurance" parent="menu_root" action="action_insurance" sequence="110"/>
    <menuitem id="menu_documents" name="Document Tracking" parent="menu_root" action="action_documents" sequence="120"/>
    <menuitem id="menu_commissions" name="Sales Commissions" parent="menu_root" action="action_commissions" sequence="130"/>
    <menuitem id="menu_dashboard" name="Management Dashboard" parent="menu_root" action="action_dashboard" sequence="140"/>
</odoo>
