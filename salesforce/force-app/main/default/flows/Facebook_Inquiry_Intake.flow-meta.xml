<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Previous_Inquiry</name>
        <label>Has Previous Inquiry</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Update_Inquiry_New_Client</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New Client</defaultConnectorLabel>
        <rules>
            <name>Previous_Inquiry_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Previous_Inquiry.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Inquiry_Existing_Client</targetReference>
            </connector>
            <label>Previous Inquiry Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Case_Description</name>
        <dataType>String</dataType>
        <expression>&quot;Facebook User ID: &quot; &amp; {!$Record.Facebook_User_ID__c} &amp; BR() &amp; &quot;Meta Conversation ID: &quot; &amp; BLANKVALUE({!$Record.Meta_Conversation_ID__c}, &quot;N/A&quot;) &amp; BR() &amp; BR() &amp; BLANKVALUE({!$Record.Customer_Message__c}, &quot;No message provided.&quot;)</expression>
    </formulas>
    <formulas>
        <name>Case_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Facebook Inquiry - &quot; &amp; IF(ISBLANK({!$Record.Customer_Name__c}), {!$Record.Facebook_User_ID__c}, {!$Record.Customer_Name__c})</expression>
    </formulas>
    <interviewLabel>Facebook Inquiry Intake {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Facebook Inquiry Intake</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Facebook_Case</name>
        <label>Create Facebook Case</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>Update_Created_Case_Contact</targetReference>
        </connector>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Case_Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Case_Subject</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Previous_Inquiry</name>
        <label>Get Previous Inquiry</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Previous_Inquiry</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Facebook_User_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Facebook_User_ID__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Facebook_Inquiry__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Created_Case_Contact</name>
        <label>Update Created Case Contact</label>
        <locationX>176</locationX>
        <locationY>188</locationY>
        <connector>
            <targetReference>Get_Previous_Inquiry</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Create_Facebook_Case</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.Contact__c</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Inquiry_Existing_Client</name>
        <label>Update Inquiry Existing Client</label>
        <locationX>100</locationX>
        <locationY>458</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Case__c</field>
            <value>
                <elementReference>Create_Facebook_Case</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Existing_Client__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Agent__c</field>
            <value>
                <elementReference>Get_Previous_Inquiry.OwnerId</elementReference>
