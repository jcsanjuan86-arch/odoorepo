<?xml version="1.0" encoding="UTF-8"?>
<!-- Least-privilege access for the Connected App's run-as integration user. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Odoo Integration</label>
    <description>Lets the Odoo integration user publish Vehicle Inventory, read Auto Loan Applications, mark them Released through AutobotiqueReleaseService, and create website inquiries with their contacts.</description>
    <customPermissions>
        <enabled>true</enabled>
        <name>Odoo_Integration</name>
    </customPermissions>
    <classAccesses>
        <apexClass>AutobotiqueReleaseService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Vehicle_Inventory__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Auto_Loan_Application__c</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <!-- Website inquiries from Odoo arrive as leads with their customer contact. -->
    <objectPermissions>
        <object>Facebook_Inquiry__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions><field>Vehicle_Inventory__c.Odoo_Vehicle_ID__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Vehicle_Inventory__c.VIN__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
    <fieldPermissions><field>Vehicle_Inventory__c.Odometer__c</field><editable>true</editable><readable>true</readable></fieldPermissions>
